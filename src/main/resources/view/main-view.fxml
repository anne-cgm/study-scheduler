<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="studyscheduler.controller.TaskController"
            stylesheets="@../style/style.css"
            prefWidth="900"
            prefHeight="700">

    <!-- ========================= -->
    <!-- TOP / WEATHER -->
    <!-- ========================= -->

    <top>

        <HBox alignment="CENTER_RIGHT"
              styleClass="weather-container">

            <HBox styleClass="weather-widget"
                  spacing="10"
                  alignment="CENTER">

                <!-- WEATHER ICON -->
                <Label fx:id="weatherIconLabel"
                       text="☁️"
                       styleClass="weather-icon"/>

                <!-- WEATHER INFO -->
                <VBox spacing="2"
                      alignment="CENTER_LEFT">

                    <HBox spacing="5"
                          alignment="CENTER_LEFT">

                        <Label fx:id="weatherStatusLabel"
                               text="Nublado"
                               styleClass="weather-status"/>

                        <Label fx:id="weatherTempLabel"
                               text="24°C"
                               styleClass="weather-temp"/>

                    </HBox>

                </VBox>

                <!-- DIVIDER -->
                <Region styleClass="weather-divider"
                        prefWidth="1"
                        prefHeight="20"/>

                <!-- TIP -->
                <HBox spacing="5"
                      alignment="CENTER_LEFT">

                    <Label text="💡"
                           styleClass="weather-tip-icon"/>

                    <Label fx:id="weatherTipLabel"
                           text="Bom momento para revisões"
                           styleClass="weather-tip"/>

                </HBox>

            </HBox>

            <padding>

                <Insets top="12"
                        right="16"
                        bottom="12"
                        left="16"/>

            </padding>

        </HBox>

    </top>

    <!-- ========================= -->
    <!-- CENTER -->
    <!-- ========================= -->

    <center>

        <VBox styleClass="main-container"
              spacing="20"
              alignment="TOP_CENTER">

            <padding>

                <Insets top="20"
                        right="16"
                        bottom="20"
                        left="16"/>

            </padding>

            <!-- TITLE -->
            <Label text="Study Scheduler"
                   styleClass="title"/>

            <!-- ========================= -->
            <!-- STATS -->
            <!-- ========================= -->

            <HBox spacing="12"
                  alignment="CENTER">

                <!-- TOTAL -->
                <VBox styleClass="stat-card"
                      alignment="CENTER"
                      prefWidth="150"
                      onMouseClicked="#filterAll">

                    <Label fx:id="totalLabel"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="TOTAL"
                           styleClass="stat-label"/>

                    <padding>

                        <Insets top="12"
                                right="16"
                                bottom="12"
                                left="16"/>

                    </padding>

                </VBox>

                <!-- COMPLETED -->
                <VBox styleClass="stat-card-completed"
                      alignment="CENTER"
                      prefWidth="150"
                      onMouseClicked="#filterCompleted">

                    <Label fx:id="completedLabel"
                           text="0"
                           styleClass="stat-number-completed"/>

                    <Label text="CONCLUÍDAS"
                           styleClass="stat-label"/>

                    <padding>

                        <Insets top="12"
                                right="16"
                                bottom="12"
                                left="16"/>

                    </padding>

                </VBox>

                <!-- OVERDUE -->
                <VBox styleClass="stat-card-overdue"
                      alignment="CENTER"
                      prefWidth="150"
                      onMouseClicked="#filterOverdue">

                    <Label fx:id="overdueLabel"
                           text="0"
                           styleClass="stat-number-overdue"/>

                    <Label text="ATRASADAS"
                           styleClass="stat-label"/>

                    <padding>

                        <Insets top="12"
                                right="16"
                                bottom="12"
                                left="16"/>

                    </padding>

                </VBox>

            </HBox>

            <!-- ========================= -->
            <!-- ADD TASK -->
            <!-- ========================= -->

            <HBox styleClass="add-task-form"
                  spacing="8"
                  alignment="CENTER_LEFT">

                <TextField fx:id="taskTitleField"
                           promptText="Adicionar tarefa"
                           styleClass="input-task-title"
                           HBox.hgrow="ALWAYS"/>

                <TextField fx:id="taskDescriptionField"
                           promptText="Descrição (opcional)"
                           styleClass="input-task-description"
                           HBox.hgrow="ALWAYS"/>

                <DatePicker fx:id="taskDatePicker"
                            promptText="Data"
                            styleClass="input-date"
                            prefWidth="135"/>

                <Button fx:id="addButton"
                        text="Adicionar"
                        styleClass="btn-add"
                        onAction="#handleAddTask">

                    <graphic>

                        <Label text="+"
                               styleClass="btn-icon"/>

                    </graphic>

                </Button>

                <padding>

                    <Insets top="12"
                            right="12"
                            bottom="12"
                            left="12"/>

                </padding>

            </HBox>

            <!-- ========================= -->
            <!-- TASK HEADER -->
            <!-- ========================= -->

            <HBox spacing="8"
                  alignment="CENTER_LEFT">

                <Label text="Suas Tarefas"
                       styleClass="task-list-header"/>

                <Label fx:id="taskCountLabel"
                       text="0"
                       styleClass="task-count-badge"/>

            </HBox>

            <!-- ========================= -->
            <!-- TASK LIST -->
            <!-- ========================= -->

            <ScrollPane styleClass="task-list-scroll"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS">

                <VBox fx:id="taskListContainer"
                      spacing="12"
                      styleClass="task-list">

                    <padding>

                        <Insets top="4"
                                right="4"
                                bottom="4"
                                left="4"/>

                    </padding>

                </VBox>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>